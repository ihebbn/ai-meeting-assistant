{
  "name": "meeting-copilot",
  "version": "0.1.0",
  "description": "Windows Meeting Copilot — Milestone 1: protected overlay verification",
  "main": "dist-electron/main.js",
  "author": "Meeting Copilot",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:angular": "ng build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:angular && npm run build:electron",
    "start": "npm run build && node scripts/run-electron.js",
    "dev": "npm run build:electron && concurrently -k \"ng serve --port 4200\" \"wait-on http://localhost:4200 && cross-env ELECTRON_DEV=1 node scripts/run-electron.js\"",
    "package:win": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && ng build --configuration=development",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "bench": "npm run build:electron && node scripts/run-electron.js dist-electron/bench/cli.js",
    "pretest": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\""
  },
  "build": {
    "appId": "com.meetingcopilot.overlay",
    "productName": "Meeting Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/menu.html",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sherpa-onnx/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@anthropic-ai/sdk": "^1.6.0",
    "@xenova/transformers": "^2.17.2",
    "electron-audio-loopback": "^1.0.6",
    "rxjs": "~7.8.1",
    "sherpa-onnx": "^2.0.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.2"
  }
}
